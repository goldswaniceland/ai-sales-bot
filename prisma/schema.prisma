generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String?
  phone           String?
  role            String           @default("client") // client, admin, partner
  createdAt       DateTime         @default(now())
  bookingRequests BookingRequest[]

  // NextAuth fields
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]

  @@map("users")
}

model JourneyTemplate {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  type            String           // ACTIVE, SERENE, EXPLORER
  duration        Int              // days
  basePrice       Int              // cents (USD)
  description     String?
  highlights      String           // JSON array of strings
  status          String           @default("published") // published, draft
  createdAt       DateTime         @default(now())
  itineraryDays   ItineraryDay[]
  bookingRequests BookingRequest[]

  @@map("journey_templates")
}

model ItineraryDay {
  id                 String           @id @default(uuid())
  journeyTemplateId  String
  dayNumber          Int
  title              String?
  description        String?
  accommodationId    String?
  createdAt          DateTime         @default(now())

  journeyTemplate    JourneyTemplate  @relation(fields: [journeyTemplateId], references: [id], onDelete: Cascade)
  accommodation      Accommodation?   @relation(fields: [accommodationId], references: [id])

  @@map("itinerary_days")
}

model Accommodation {
  id            String         @id @default(uuid())
  name          String
  location      String?
  pricePerNight Int?           // cents
  description   String?
  imageUrl      String?
  partnerId     String?

  partner       Partner?       @relation(fields: [partnerId], references: [id])
  itineraryDays ItineraryDay[]

  @@map("accommodations")
}

model AddOn {
  id            String   @id @default(uuid())
  name          String
  category      String?  // activities, dining, special
  price         Int      // cents
  description   String?
  applicableTo  String   // JSON: ['ACTIVE', 'SERENE'] or ['all']

  @@map("add_ons")
}

model BookingRequest {
  id                 String           @id @default(uuid())
  userId             String
  journeyTemplateId  String
  startDate          DateTime
  travelers          Int
  selectedAddOns     String           // JSON array of add_on ids
  totalPrice         Int              // cents, calculated
  status             String           @default("pending") // pending, confirmed, cancelled
  specialRequests    String?
  createdAt          DateTime         @default(now())

  user               User             @relation(fields: [userId], references: [id])
  journeyTemplate    JourneyTemplate  @relation(fields: [journeyTemplateId], references: [id])
  booking            Booking?

  @@map("booking_requests")
}

model Booking {
  id                    String         @id @default(uuid())
  bookingRequestId      String         @unique
  stripePaymentIntentId String?
  paymentStatus         String         @default("pending") // pending, paid, refunded
  depositAmount         Int            // 50% upfront
  balanceAmount         Int            // 50% later
  balanceDueDate        DateTime?
  itineraryPdfUrl       String?
  createdAt             DateTime       @default(now())

  bookingRequest        BookingRequest @relation(fields: [bookingRequestId], references: [id])

  @@map("bookings")
}

model Partner {
  id             String          @id @default(uuid())
  name           String
  type           String?         // accommodation, activity, dining, transport
  email          String?
  phone          String?
  status         String          @default("active")

  accommodations Accommodation[]

  @@map("partners")
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
